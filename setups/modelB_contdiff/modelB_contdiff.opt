# Model B (Paper II), dust stage with continuity-only dust diffusion. See README.md.

FLUIDS := 0 1
NFLUIDS = 2
FARGO_OPT += -DNFLUIDS=${NFLUIDS}

MONITOR_SCALAR = MASS | MOM_X | TORQ
MONITOR_Y_RAW  = TORQ

FARGO_OPT += -DX
FARGO_OPT += -DY
FARGO_OPT += -DZ
FARGO_OPT += -DADIABATIC
FARGO_OPT += -DSPHERICAL
FARGO_OPT += -DPOTENTIAL
FARGO_OPT += -DALPHAVISCOSITY
FARGO_OPT += -DDRAGFORCE
FARGO_OPT += -DSTOKESNUMBER
FARGO_OPT += -DDUSTDIFFUSION
FARGO_OPT += -DDUSTDIFFD2G_REDUCTION
FARGO_OPT += -DSTOCKHOLM
FARGO_OPT += -DBETACOOLING
FARGO_OPT += -DFLOOR
FARGO_OPT += -DLONGSUMMARY
FARGO_OPT += -DWARPSHUFFLE

ifeq (${GPU}, 1)
FARGO_OPT += -DBLOCK_X=32
FARGO_OPT += -DBLOCK_Y=4
FARGO_OPT += -DBLOCK_Z=2
endif
